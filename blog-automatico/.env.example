# Copia questo file in .env (che NON va mai su GitHub) e compila i valori.
WP_URL=https://www.roccoandrealigorio.it
WP_USER=admin
# Password applicativa creata in WordPress: Utenti > Profilo > Password applicative.
# Una diversa per ogni PC, così se ne perdi uno revochi solo quella.
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
